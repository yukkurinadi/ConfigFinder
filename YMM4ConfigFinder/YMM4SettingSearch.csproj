<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>YMM4SettingSearch</AssemblyName>
    <RootNamespace>YMM4SettingSearch</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="YukkuriMovieMaker.Settings">
      <HintPath>C:\YMM4\YukkuriMovieMaker.Settings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="YukkuriMovieMaker.Plugin">
      <HintPath>C:\YMM4\YukkuriMovieMaker.Plugin.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
